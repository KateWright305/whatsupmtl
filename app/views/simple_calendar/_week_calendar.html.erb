<div class="simple-calendar d-flex flex-column gap-4">
  <div class="calendar-heading">
    <nav class="d-flex justify-content-between align-items-center">

      <%= link_to calendar.url_for_previous_view, class: "btn-light", aria: { label: "Last week" } do %>
        <i class="fa-solid fa-chevron-left"></i>
      <% end %>

      <span class="fw-medium">
        <%= date_range.first.strftime("%d %b") %> -
        <%= date_range.last.strftime("%d %b") %>
      </span>

      <%= link_to calendar.url_for_next_view, class: "btn-light", aria: { label: "Next week" } do %>
        <i class="fa-solid fa-chevron-right"></i>
      <% end %>

    </nav>
  </div>

  <div class="calendar-days d-flex flex-column gap-2">
    <% date_range.each do |day| %>
      <div class="calendar-day">
        <% instance_exec(day, calendar.sorted_events_for(day), &passed_block) %>
      </div>
    <% end %>
  </div>
</div>
