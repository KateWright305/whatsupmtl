<div class="simple-calendar">
  <div class="calendar-heading">
    <nav>
      <%= link_to t('simple_calendar.today', default: 'This week'), calendar.url_for_today_view %>
      <%= link_to t('simple_calendar.previous', default: 'Last week'), calendar.url_for_previous_view %>
      <%= link_to t('simple_calendar.next', default: 'Next week'), calendar.url_for_next_view %>
    </nav>
  </div>

  <div class="calendar-days">
    <% date_range.each do |day| %>
      <div class="calendar-day">
        <% instance_exec(day, calendar.sorted_events_for(day), &passed_block) %>
      </div>
    <% end %>
  </div>
</div>
