<div class="container my-4" style="max-width: 800px;">
  <div class="card shadow-sm p-4">
    <h4 class="mb-1">Edit Preferences</h4>
    <p class="text-muted mb-4">Choose the activities you like.</p>

    <%= simple_form_for @user, url: preferences_path do |f| %>
      <h6 class="mb-3">Types</h6>
      <%= f.association :types, as: :check_boxes, legend_tag: false, wrapper_html: { class: "preferences-types", style: "columns: 200px;" } %>
      <hr class="my-4">
      <div class="d-flex justify-content-end gap-2">
        <%= link_to "Cancel", profile_path, class: "btn btn-outline-secondary" %>
        <%= f.button :submit, "Save Preferences", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
