
<div class="container py-5">

  <!-- Group Header -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">

      <%= link_to groups_path,
          class: "text-decoration-none text-muted mb-3 d-inline-block" do %>
        <i class="fa-solid fa-arrow-left me-2"></i>
        Back to Groups
      <% end %>

      <div class="d-flex align-items-center gap-3">
        <div class="bg-primary bg-opacity-10 rounded-3 p-4">
          <i class="fa-solid fa-users text-primary fs-2"></i>
        </div>

        <div>
          <h2 class="fw-bold mb-1">
            <%= @group.name %>
          </h2>

          <p class="text-muted mb-0">
            <%= @group.description %>
          </p>
        </div>
      </div>

      <hr>

      <div class="d-flex gap-4">
        <div>
          <h4 class="fw-bold mb-0">
            <%= @group.activities.size %>
          </h4>
          <small class="text-muted">Activities</small>
        </div>

        <div>
          <h4 class="fw-bold mb-0">
            <%= @group.created_at.strftime("%b %d") %>
          </h4>
          <small class="text-muted">Created</small>
        </div>
      </div>

    </div>
  </div>

  <!-- Activities -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">Group Activities</h4>
  </div>

  <div class="row g-4">

    <% @group.activities.each do |activity| %>

      <div class="col-md-6 col-lg-4">

        <div class="card border-0 shadow-sm h-100">

          <% if activity.photo.attached? %>
            <%= image_tag activity.photo,
                class: "card-img-top",
                style: "height:200px; object-fit:cover;" %>
          <% end %>

          <div class="card-body">

            <h5 class="fw-bold">
              <%= activity.description %>
            </h5>

            <p class="text-muted mb-2">
              <i class="fa-solid fa-location-dot me-2"></i>
              <%= activity.location %>
            </p>

            <p class="text-muted mb-3">
              <i class="fa-regular fa-calendar me-2"></i>
              <%= activity.starts_at&.strftime("%b %d, %Y %H:%M") %>
            </p>

            <%= link_to "View Activity",
                activity_path(activity),
                class: "btn btn-outline-primary btn-sm" %>

          </div>
        </div>

      </div>

    <% end %>

    <% if @group.activities.empty? %>
      <div class="col-12">
        <div class="alert alert-light text-center">
          No activities associated with this group yet.
        </div>
      </div>
    <% end %>

  </div>

</div>
