<div>

  <%= link_to groups_path do %>
    <i class="fa-solid fa-arrow-left"></i>
    Back to Groups
  <% end %>

  <div>
    <h2><%= @group.name %></h2>
    <p><%= @group.description %></p>
  </div>

</div>

<hr>

<div>
  <h4><%= @group.activities.size %></h4>
  <small>Activities</small>
</div>

<div>
  <h4><%= @group.created_at.strftime("%b %d") %></h4>
  <small>Created</small>
</div>

<hr>

<h4>Group Activities</h4>

<% @group.activities.each do |activity| %>

  <div>

    <% if activity.photo.attached? %>
      <%= image_tag activity.photo, width: 150 %>
    <% end %>

    <h5><%= activity.name %></h5>

    <p><%= activity.description %></p>

    <p><%= activity.location %></p>

    <p>
      <%= activity.starts_at&.strftime("%b %d, %Y %H:%M") %>
    </p>

    <%= link_to "View Activity", activity_path(activity) %>

    <%= link_to "Remove from group",
                remove_activity_group_path(@group, activity_id: activity.id),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Remove this activity from the group?"
                } %>

  </div>

  <hr>

<% end %>

<% if @group.activities.empty? %>
  <p>No activities associated with this group yet.</p>
<% end %>

<hr>

<h4>Add Activity to Group</h4>

<% if @activities.any? %>

  <%= form_with url: add_activity_group_path(@group),
                method: :post,
                local: true do %>

    <div>
      <%= label_tag :activity_id, "Select an activity" %>

      <%= select_tag :activity_id,
                     options_from_collection_for_select(@activities, :id, :name),
                     prompt: "Choose an activity",
                     required: true %>
    </div>

    <br>

    <%= submit_tag "Add Activity" %>

  <% end %>

<% else %>

  <p>All activities are already associated with this group.</p>

<% end %>

<hr>

<%= link_to "Edit Group", edit_group_path(@group) %>
