<%= form_with url: add_to_group_group_activities_path(@group), method: :post do |f| %>

  <div class="mb-3">
    <%= f.label :activity_id, "Select an activity" %>

    <%= f.collection_select :activity_id,
        Activity.all,
        :id,
        :description,
        { prompt: "Choose an activity" },
        { class: "form-select" } %>
  </div>

  <%= f.submit "Add Activity", class: "btn btn-primary" %>

<% end %>
