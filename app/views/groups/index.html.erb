<header>
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3 my-4">

    <div>
      <h1 class="mb-2">Groups</h1>
      <p class="text-muted small mb-0">Organise your activities into groups</p>
    </div>

    <%= link_to "Create New Group", new_group_path, class: "btn btn-primary rounded-3" %>

  </div>
</header>

<div class="container d-flex flex-column gap-4">
  <% @groups.each do |group| %>

    <div>
      <%= render "groups/group", group: group %>
    <% end %>

  <% if @groups.empty? %>
    <div>
      <h5>No groups yet</h5>
      <p>Create your first group to get started.</p>
    </div>
  <% end %>
</div>
