
<div class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">Groups</h2>
      <p class="text-muted mb-0">
        Discover and manage your communities
      </p>
    </div>

    <%= link_to new_group_path, class: "btn btn-primary" do %>
      <i class="fa-solid fa-plus me-2"></i>
      Create Group
    <% end %>
  </div>

  <div class="row g-4">

    <% @groups.each do |group| %>
      <div class="col-md-6 col-lg-4">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="d-flex justify-content-between mb-3">
              <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                <i class="fa-solid fa-users text-primary fs-4"></i>
              </div>

              <span class="badge bg-light text-dark align-self-start">
                <%= group.activities.size %> Activities
              </span>
            </div>

            <h5 class="fw-bold">
              <%= group.name %>
            </h5>

            <p class="text-muted">
              <%= truncate(group.description, length: 110) %>
            </p>

            <hr>

            <div class="d-flex justify-content-between align-items-center">

              <small class="text-muted">
                Created <%= group.created_at.strftime("%b %d, %Y") %>
              </small>

              <%= link_to "View Group",
                  group_path(group),
                  class: "btn btn-outline-primary btn-sm" %>

            </div>

          </div>
        </div>

      </div>
    <% end %>

    <% if @groups.empty? %>
      <div class="col-12 text-center py-5">
        <i class="fa-solid fa-users fs-1 text-muted"></i>
        <h5 class="mt-3">No groups yet</h5>
        <p class="text-muted">
          Create your first group to get started.
        </p>
      </div>
    <% end %>

  </div>
</div>
