<div>
  <h2>Groups</h2>

  <p>
    Manage your groups
  </p>

  <%= link_to new_group_path do %>
    <i class="fa-solid fa-plus"></i>
    Create Group
  <% end %>
</div>

<hr>

<div>
  <% @groups.each do |group| %>

<%= render "groups/group", group: group %>

  <% end %>

  <% if @groups.empty? %>
    <div>
      <h5>No groups yet</h5>

      <p>
        Create your first group to get started.
      </p>
    </div>
  <% end %>
</div>
