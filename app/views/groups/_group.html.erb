<div class="card group-card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h4 class="mb-0"><%= group.name %></h4>
    <div>
      <button class="btn btn-outline-primary btn-sm"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#group-<%= group.id %>">
        See activities (<%= group.activities.count %>)
      </button>
      <%= link_to group_path(group),
      data: {
        turbo_method: :delete,
        turbo_confirm: "Are you sure you want to delete this group?"
      },
      class: "btn btn-outline-danger btn-sm" do %>

      <i class="fa-solid fa-xmark"></i> Delete group

      <% end %>
    </div>
  </div>

  <div class="collapse" id="group-<%= group.id %>">
    <div class="card-body">

      <p class="mb-1">
        <%= truncate(group.description, length: 110) %>
      </p>

      <small class="d-block text-muted mb-4">
        Created <%= group.created_at.strftime("%b %d, %Y") %>
      </small>

      <% if group.activities.any? %>

  <h6 class="text-muted mb-2">Activities</h6>

    <ul class="list-unstyled">
      <% group.activities.each do |activity| %>

        <li class="d-flex justify-content-between align-items-center bg-light rounded-3 p-3 mb-2">

          <%= link_to activity_path(activity),
              class: "text-decoration-none fw-medium" do %>
            <i class="fa-regular fa-calendar me-2"></i>
            <%= activity.name %>
          <% end %>

          <%= link_to remove_activity_group_path(group, activity_id: activity.id),
              data: {
                turbo_method: :delete,
                turbo_confirm: "Are you sure you want to remove this activity from the group?"
              },
              class: "text-muted",
              aria: { label: "Remove activity" } do %>
            <i class="fa-solid fa-xmark"></i>
          <% end %>

        </li>

      <% end %>
    </ul>

    <% else %>
      <p>No activities associated with this group yet.</p>
    <% end %>

    <button type="button"
      class="btn btn-outline-primary btn-sm"
      data-bs-toggle="collapse"
      data-bs-target="#activities-<%= group.id %>"
      aria-expanded="false"
      aria-controls="activities-<%= group.id %>">
    <i class="fa-solid fa-plus"></i> Add activity
    </button>

    <%= render "groups/add_activity_form",
      group: group,
      activities: @activities %>

    </div>
  </div>
</div>
