<div class="card group-card p-4">

  <%= form_with model: @group do |f| %>

    <% if @group.errors.any? %>
      <div class="alert alert-danger">
        <% @group.errors.full_messages.each do |message| %>
          <p class="mb-1"><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :name, "Group Name", class: "form-label fw-medium" %>

      <%= f.text_field :name,
        class: "form-control bg-light border-0 rounded-3 p-3",
        placeholder: "Enter group name" %>
    </div>

    <div class="mb-4">
      <%= f.label :description, class: "form-label fw-medium" %>

      <%= f.text_area :description,
          class: "form-control bg-light border-0 rounded-3 p-3",
          rows: 4,
          placeholder: "Describe your group..." %>
    </div>

    <div class="d-flex justify-content-between align-items-center">
      <%= link_to "Cancel",
          @group.persisted? ? group_path(@group) : groups_path,
          class: "btn btn-outline-secondary" %>

      <%= f.submit(@group.persisted? ? "Update Group" : "Create Group",
          class: "btn btn-primary") %>
    </div>
  <% end %>
</div>
