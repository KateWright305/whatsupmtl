
<%= form_with model: @group do |f| %>

  <% if @group.errors.any? %>
    <div>
      <% @group.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Group Name" %>
    <%= f.text_field :name, placeholder: "Enter group name" %>
  </div>

  <div>
    <%= f.label :description %>
    <%= f.text_area :description,
        rows: 4,
        placeholder: "Describe your group..." %>
  </div>

  <div>
    <%= f.submit(@group.persisted? ? "Update Group" : "Create Group") %>

    <%= link_to "Cancel",
        @group.persisted? ? group_path(@group) : groups_path %>
  </div>

<% end %>
