
<!-- NAVBAR -->
<nav class="whatsup-navbar navbar navbar-expand-lg">

  <div class="container">
    <%= link_to root_path, class: "navbar-brand" do %>
      <span class="brand-icon">
        <i class="fa-solid fa-location-dot"></i>
      </span>

      <span class="brand-text">
        WhatsUp<span class="brand-highlight">MTL</span>
      </span>

    <% end %>

    <button class="navbar-toggler custom-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#whatsupNavbar"
            aria-controls="whatsupNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation">

      <i class="fa-solid fa-bars"></i>

    </button>

    <div class="collapse navbar-collapse" id="whatsupNavbar">

      <ul class="navbar-nav mx-auto nav-main">
        <li class="nav-item">
          <%= link_to root_path, class: "nav-link" do %>

            Home
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to activities_path, class: "nav-link" do %>
            Activities
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to groups_path, class: "nav-link" do %>
            Groups
          <% end %>
        </li>
      </ul>

      <div class="navbar-user-section">

        <% if user_signed_in? %>
          <div class="dropdown">

            <button class="user-dropdown-btn dropdown-toggle"
                    type="button"
                    id="navbarUserDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">

              <div class="user-avatar">
                <i class="fa-solid fa-user"></i>
              </div>
              <span>My account</span>
            </button>

            <ul class="dropdown-menu dropdown-menu-end custom-user-menu"
                aria-labelledby="navbarUserDropdown">

              <li>
                <%= link_to profile_path, class: "dropdown-item" do %>
                  <i class="fa-solid fa-user me-2"></i>
                  My Profile
                <% end %>
              </li>

              <li>
                <%= link_to edit_preferences_path, class: "dropdown-item" do %>
                  <i class="fa-solid fa-sliders me-2"></i>
                  Preferences
                <% end %>
              </li>

              <li>
                <hr class="dropdown-divider">
              </li>

              <li>
                <%= link_to destroy_user_session_path,
                    data: { turbo_method: :delete },
                    class: "dropdown-item text-danger" do %>

                  <i class="fa-solid fa-right-from-bracket me-2"></i>
                  Log out

                <% end %>
              </li>
            </ul>
          </div>


        <% else %>

          <div class="navbar-auth-buttons">
            <%= link_to "Log in",
                new_user_session_path,
                class: "btn-login" %>

            <%= link_to new_user_registration_path,
                class: "btn-signup" do %>

              Sign up
              <i class="fa-solid fa-arrow-right ms-2"></i>
            <% end %>
          </div>

        <% end %>
      </div>
    </div>
  </div>
</nav>
