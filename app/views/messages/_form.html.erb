<%= simple_form_for [chat, message] do |f| %>
  <div class="d-flex gap-2 align-items-start">
    <div class="flex-grow-1">
      <%= f.input :content, as: :string, label: false, placeholder: "What would you like to do?" %>
<%= turbo_frame_tag "new_message" do %>
  <%= simple_form_for [chat, message] do |f| %>
    <div class="d-flex gap-2 align-items-start">
      <div class="flex-grow-1">
        <%= f.input :content, as: :string, label: false, placeholder: "Descrive your activity" %>
      </div>
      <%= f.button :submit, "Send", class: "btn btn-primary", data: { turbo_submits_with: "Searching…" } %>
    </div>
  <% end %>
<% end %>
