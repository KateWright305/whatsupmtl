<div>
  <%= tool["name"] %>
  <p><%= tool["location"] %> · <%= tool["starts_at"] %> · <%= tool["price"] %> $</p>
  <p><%= tool["description"] %></p>
  <%= simple_form_for Activity.new, url: activities_path do |form| %>
    <%= form.input :name, as: :hidden, input_html: { value: tool["name"] } %>
    <%= form.input :description, as: :hidden, input_html: { value: tool["description"] } %>
    <%= form.input :url, as: :hidden, input_html: { value: tool["url"] } %>
    <%= form.input :location, as: :hidden, input_html: { value: tool["location"] } %>
    <%= form.input :price, as: :hidden, input_html: { value: tool["price"] } %>
    <%= form.input :img, as: :hidden, input_html: { value: tool["img"] } %>
    <%= form.input :starts_at, as: :hidden, input_html: { value: tool["starts_at"] } %>
    <%= form.input :ends_at, as: :hidden, input_html: { value: tool["ends_at"] } %>
    <%= form.button :submit, "Save activity", class: "btn btn-primary btn-sm mt-2" %>
  <% end %>
</div>
