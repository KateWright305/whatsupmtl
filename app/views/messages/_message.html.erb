<% if message.tool_result? %>
<%= render partial: "messages/activity_tool_call", locals: {tool: JSON.parse(message.content)} %>
<% elsif message.tool_call? || message.role == "system" %>
<% else %>
  <div class="d-flex flex-column mb-3 <%= message.role == "user" ? "align-items-end" : "align-items-start" %>">
    <small class="text-muted mb-1">
      <%= message.role == "user" ? "You" : "Assistant" %>
    </small>
    <div class="px-3 py-2 rounded-4 shadow-sm <%= message.role == "user" ? "bg-primary text-white" : "bg-light" %>" style="max-width: 75%;">
      <%= sanitize(render_markdown(message.content)) %>
    </div>
  </div>
<% end %>
