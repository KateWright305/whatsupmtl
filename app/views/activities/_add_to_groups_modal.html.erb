<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addToGroupsModal">
  Add to groups
</button>

<div class="modal fade" id="addToGroupsModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <%= form_with url: save_groups_activity_path(activity), method: :post do %>
        <div class="modal-header">
          <h5 class="modal-title">Add <%= activity.name %> to groups</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <% groups.each do |group| %>
            <div class="form-check">
              <%= check_box_tag "group_ids[]", group.id, activity.groups.include?(group),
                    class: "form-check-input", id: "group_#{group.id}" %>
              <%= label_tag "group_#{group.id}", group.name, class: "form-check-label" %>
            </div>
          <% end %>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <%= submit_tag "Save", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
