<header>
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3 my-4">

    <div>
      <h1 class="mb-2">Weekly Planner</h1>
      <p class="text-muted small mb-0">Your activities for the week</p>
    </div>

    <%= simple_form_for @chat do |f| %>
      <%= f.button :submit, "Find activities to add",
          class: "btn btn-primary rounded-3" %>
    <% end %>

  </div>
</header>

<div class="container d-flex flex-column gap-4 weekly-planner">
  <div>
    <%= week_calendar(events: @activities, attribute: :starts_at) do |date, activities| %>

      <div class="d-flex align-items-center gap-2 mb-1">

        <div class="day-number <%= 'current-day' if date == Date.current %>">
          <%= date.strftime("%d") %>
        </div>

        <h5 class="mb-0"><%= date.strftime("%A") %></h5>

        <% if date == Date.current %>
          <span class="text-primary small">Today</span>
        <% end %>

      </div>

      <div class="d-flex flex-column gap-2">

        <% if activities.empty? %>
          <p class="text-muted small empty-day">No activities planned</p>
        <% end %>

        <% activities.each do |activity| %>
          <%= render "activity", activity: activity %>
        <% end %>

      </div>

    <% end %>
  </div>
</div>
