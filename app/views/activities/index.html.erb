<h1>My week</h1>

<% start_date = Date.current.beginning_of_week %>
<% end_date = Date.current.end_of_week %>

<% if start_date.month == end_date.month %>
  <%= "#{start_date.day.ordinalize} - #{end_date.day.ordinalize} #{end_date.strftime('%B')}" %>
<% else %>
  <%= "#{start_date.day.ordinalize} #{start_date.strftime('%B')} - #{end_date.day.ordinalize} #{end_date.strftime('%B')}" %>
<% end %>

<%= week_calendar(number_of_weeks: 1) do |date| %>
  <%= date %>
<% end %>

<ul>
  <% @activities.each do |activity| %>
    <li>
      <%= link_to activity.name, activity_path(activity) %></li>

      <p><%= activity.img %></p>
      <p><%= activity.starts_at.strftime("%H:%M") %></p>
      <p><%= activity.ends_at.strftime("%H:%M") %></p>

      <ul>
        <% activity.types.each do |type| %>
          <li><%= type.name %></li>
        <% end %>
      </ul>

    </li>
  <% end %>
</ul>

<%= simple_form_for @chat do |f| %>
  <%= f.button :submit, "Start a conversation",
  class: "btn btn-outline-primary btn-sm"%>
<% end %>
