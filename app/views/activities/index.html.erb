<h1>Activities</h1>

<ul>
  <% @activities.each do |activity| %>
    <li>
      <%= render "activities/activity", activity: activity %>
    </li>
  <% end %>
</ul>

<%= simple_form_for @chat do |f| %>
  <%= f.button :submit, "Start a conversation",
  class: "btn btn-outline-primary btn-sm"%>
<% end %>
