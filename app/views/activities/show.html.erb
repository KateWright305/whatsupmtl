<p><%= @activity.img %></p>

<h1><%= @activity.name %></h1>

<p><%= @activity.description %></p>
<p><%= link_to @activity.url, @activity.url %></p>
<p>Location: <%= @activity.location %></p>
<p>Price: $<%= @activity.price %></p>
<p>Start: <%= @activity.starts_at.strftime("%H:%M") %></p>
<p>End: <%= @activity.ends_at.strftime("%H:%M") %></p>

<ul>
  <% @activity.types.each do |type| %>
    <li><%= type.name %></li>
  <% end %>
</ul>

<%= link_to "Back to activities", activities_path %>
