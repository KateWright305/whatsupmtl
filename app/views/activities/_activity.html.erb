<div class="card mb-1 activity-card">
  <div class="d-flex">
    <%= image_tag "nightlife.jpeg", class: "rounded-start activity-img", alt: "Nightlife" %>
    <div class="card-body p-2">
      <h6 class="card-title">
        <strong><%= link_to activity.name, activity_path(activity),
        class: "text-decoration-none text-reset" %></strong>
      </h6>
      <p class="card-text">
        <i class="fa-regular fa-clock"></i>
        <%= activity.starts_at.strftime("%H:%M") %> -
        <%= activity.ends_at.strftime("%H:%M") %>

        <i class="fa-solid fa-location-dot ms-3"></i>
        <%= activity.location %>
        <p class="card-text text-truncate"><%= activity.description %></p>
      </p>
    </div>
  </div>
</div>
