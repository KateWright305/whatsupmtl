<div class="card mb-1 activity-card">
  <div class="d-flex align-items-stretch">

    <%= image_tag "nightlife.jpeg",
        class: "rounded-start activity-img",
        alt: "Nightlife" %>

    <div class="card-body p-3">

      <h6 class="card-title mb-2">
        <strong>
          <%= link_to activity.name, activity_path(activity),
              class: "text-decoration-none text-reset stretched-link" %>
        </strong>
      </h6>

      <p class="activity-meta text-muted small mb-1">
        <i class="fa-regular fa-clock"></i>
        <%= activity.starts_at.strftime("%H:%M") %> -
        <%= activity.ends_at.strftime("%H:%M") %>
      </p>

      <p class="activity-meta text-muted small mb-0">
        <i class="fa-solid fa-location-dot"></i>
        <%= activity.location %>
      </p>

    </div>

    <i class="fa-solid fa-chevron-right text-muted me-3 align-self-center"></i>

  </div>
</div>
